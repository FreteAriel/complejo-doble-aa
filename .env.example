# ── Configuración del servidor ─────────────────────────────────────────
# URL pública de tu proyecto en Railway (la que ya tenés)
BASE_URL=https://el-roble-production.up.railway.app

# Ruta de la base de datos SQLite (Railway usa /data si tenés volumen montado)
DB_PATH=doble_aa.db

# ── MercadoPago ────────────────────────────────────────────────────────
# Tu Access Token de producción (lo encontrás en mercadopago.com/developers)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx

# ── Twilio WhatsApp ────────────────────────────────────────────────────
# Credenciales de tu cuenta Twilio (console.twilio.com)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Número de WhatsApp de Twilio asignado (con prefijo whatsapp:)
TWILIO_NUMBER=whatsapp:+14155238886
